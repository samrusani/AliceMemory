{
  "manifest_version": "0.3",
  "name": "alice-memory",
  "display_name": "Alice Memory",
  "version": "0.20.0",
  "description": "Local-first memory for AI agents. Import is a source. Commit is a fact.",
  "author": {
    "name": "Sami Rusani",
    "url": "https://www.alicememory.com"
  },
  "homepage": "https://www.alicememory.com",
  "server": {
    "type": "binary",
    "entry_point": "uvx",
    "mcp_config": {
      "command": "uvx",
      "args": [
        "alice-memory",
        "mcp",
        "--data-dir",
        "${user_config.data_dir}"
      ]
    }
  },
  "user_config": {
    "data_dir": {
      "type": "directory",
      "title": "Alice data directory",
      "description": "Local SQLite vault directory. Defaults to ~/.alice.",
      "default": "${HOME}/.alice",
      "required": false
    }
  }
}
