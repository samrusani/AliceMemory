APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_MODE=stdout
APP_ACCESS_LOG=false
# To opt into bounded file logging, also set APP_LOG_PATH and keep rotation enabled.
# APP_LOG_PATH=/var/log/alicebot/api.log
# APP_LOG_MAX_BYTES=10485760
# APP_LOG_BACKUP_COUNT=5
# Development-only local credentials. Override for any shared or remote environment.
DATABASE_URL=postgresql://alicebot_app:alicebot_app@localhost:5432/alicebot
DATABASE_ADMIN_URL=postgresql://alicebot_admin:alicebot_admin@localhost:5432/alicebot
REDIS_URL=redis://localhost:6379/0
# Optional Docker Compose host port overrides when another local stack owns
# 5432/6379. If you set these, update DATABASE_URL, DATABASE_ADMIN_URL,
# and REDIS_URL ports above.
# ALICEBOT_POSTGRES_HOST_PORT=15432
# ALICEBOT_REDIS_HOST_PORT=16379
# Embedding provider for hybrid retrieval (any OpenAI-compatible /embeddings
# endpoint: Ollama, LM Studio, OpenAI, ...). Without these, retrieval degrades
# to full-text-only and says so in traces.
# ALICE_EMBEDDINGS_BASE_URL=http://localhost:11434/v1
# ALICE_EMBEDDINGS_MODEL=nomic-embed-text
# ALICE_EMBEDDINGS_API_KEY=
# Most characters of one memory's text sent to the endpoint (256 to 1000000,
# default 8000). Set it lower for a model with a small window, for example 1500
# for a 512-token model.
# ALICE_EMBEDDINGS_MAX_INPUT_CHARS=8000
# Model endpoint for model-backed features (Ask Alice, model-backed
# consolidation merges). MODEL_API_KEY falls back to OPENAI_API_KEY.
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-5-mini
# MODEL_API_KEY=
# OPENAI_API_KEY=
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=alicebot
S3_SECRET_KEY=alicebot-secret
S3_BUCKET=alicebot-local
HEALTHCHECK_TIMEOUT_SECONDS=2
TASK_WORKSPACE_ROOT=/tmp/alicebot/task-workspaces
# Server-side authenticated user binding for /v0 requests.
ALICEBOT_AUTH_USER_ID=00000000-0000-0000-0000-000000000001
# Default sample-data fixture consumed by ./scripts/load_sample_data.sh.
PUBLIC_SAMPLE_DATA_PATH=fixtures/public_sample_data/continuity_v1.json
# Optional compatibility surfaces; only the exact value 1 enables HTTP/CLI/worker mounts.
ALICE_LEGACY_SURFACES=0
# Optional long-tail MCP tools retain case-insensitive 1/true/yes/on compatibility.
ALICE_MCP_LEGACY_TOOLS=0
# Browser security posture.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Extra Host names a keyless API accepts besides localhost, 127.0.0.1 and ::1.
# Exact names or IP addresses only, comma separated: no wildcard, port or scheme.
# A request with an agent key on /v0/vnext or /v1 is not checked. The legacy /v0
# routes take no key, so every request to them is checked.
# ALICEBOT_ALLOWED_HOSTS=
# Request body limits in bytes. A body over the first is refused with HTTP 413
# before it is read; the second applies to POST /v0/vnext/connectors/{name}/sync.
# ALICEBOT_MAX_REQUEST_BODY_BYTES=4194304
# ALICEBOT_MAX_CONNECTOR_SYNC_BODY_BYTES=33554432
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-AliceBot-User-Id
CORS_ALLOW_CREDENTIALS=false
CORS_PREFLIGHT_MAX_AGE_SECONDS=600
# Local /vnext live browser settings. These are public values consumed by Next.js.
NEXT_PUBLIC_ALICEBOT_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ALICEBOT_USER_ID=00000000-0000-0000-0000-000000000001
SECURITY_HEADERS_ENABLED=true
SECURITY_HEADERS_HSTS_MAX_AGE_SECONDS=31536000
SECURITY_HEADERS_HSTS_INCLUDE_SUBDOMAINS=true
# Proxy and ingress trust boundaries.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=
# Memory write gate. Unset means review-gated, which is the behaviour every
# deployment had before promotion personas existed. Set it only on purpose.
#   personal   auto-promote; review is optional and never blocking
#   team       auto-promote, plus a non-blocking digest review entry
#   enterprise review-gated, identical to leaving this unset
ALICE_MEMORY_PERSONA=
# Enable-list of escalation filters that force review even under personal.
# Unset, empty or whitespace keeps all seven on. Naming a subset keeps ONLY
# those. Turning every filter off requires the literal value
# DISABLE_ALL_ESCALATION_FILTERS. The hard floor is not listed here and cannot
# be configured at all.
#   contradicts_existing_memory,private_or_higher_sensitivity,restricted_domain,indirect_provenance,third_party_person,unverified_authority_claim,agent_control_vocabulary
ALICE_MEMORY_ESCALATION_FILTERS=
# Names for the deployment owner, so a memory about the owner is not treated
# as a claim about a third party. Comma separated.
ALICE_MEMORY_OWNER_ALIASES=
# Auto-promotion additionally requires at least one active agent API key.
# Without a key nobody is distinguishable from anybody, so an anonymous caller
# is never treated as the owner and no write is promoted. Create one with
# 'alicebot agent keys create'.
