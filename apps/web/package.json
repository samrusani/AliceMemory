{
  "name": "@alicebot/web",
  "private": true,
  "version": "0.16.0",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:advisory-audit": "node --test scripts/npm-advisory-audit.test.mjs",
    "test:coverage": "pnpm run test:coverage:core && pnpm run test:coverage:vnext",
    "test:coverage:core": "vitest run --coverage --exclude app/vnext/page.test.tsx --exclude components/vnext-operator-auth.test.tsx --exclude test/vnext-coverage/vnext-coverage.test.tsx",
    "test:coverage:vnext": "vitest run --config vitest.vnext.config.ts --coverage",
    "setup:browser": "playwright install chromium",
    "setup:browser:linux": "playwright install --with-deps chromium",
    "test:browser": "pnpm run test:browser:core && pnpm run test:browser:legacy && pnpm run test:browser:outage && pnpm run test:browser:partial-outage",
    "test:browser:core": "playwright test",
    "test:browser:legacy": "playwright test --config playwright.legacy.config.ts",
    "test:browser:outage": "playwright test --config playwright.outage.config.ts",
    "test:browser:partial-outage": "playwright test --config playwright.partial-outage.config.ts",
    "test:budget": "node scripts/check-bundle-budget.mjs",
    "test:mvp:validation-matrix": "vitest run test/periphery-cut.test.ts lib/legacy-surfaces.server.test.ts components/shell-basics.test.tsx app/approvals/page.test.tsx app/tasks/page.test.tsx app/artifacts/page.test.tsx app/gmail/page.test.tsx app/calendar/page.test.tsx app/memories/page.test.tsx app/entities/page.test.tsx components/trace-list.test.tsx lib/api.test.ts"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "30.0.1",
    "semver": "7.8.0",
    "typescript": "6.0.3",
    "vitest": "3.2.6"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "js-yaml@4": "4.3.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.26",
      "sharp": "0.35.0",
      "vite": "6.4.3",
      "ws": "8.21.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
